<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Crash Demo Game</title>

<style>
*{box-sizing:border-box}
body{
  margin:0;
  font-family:Arial,sans-serif;
  background:#101522;
  color:white;
  text-align:center;
}
.container{
  max-width:500px;
  margin:auto;
  padding:20px;
}
h1{margin:10px 0 5px}
.demo{
  color:#aaa;
  margin-bottom:20px;
}
.game{
  height:300px;
  background:linear-gradient(#182235,#0c111c);
  border-radius:20px;
  position:relative;
  overflow:hidden;
  border:1px solid #29354d;
}
.multiplier{
  font-size:55px;
  font-weight:bold;
  position:absolute;
  top:90px;
  width:100%;
}
.plane{
  position:absolute;
  font-size:45px;
  left:25px;
  bottom:25px;
  transition:.1s;
}
button{
  width:100%;
  padding:15px;
  margin-top:15px;
  border:0;
  border-radius:12px;
  font-size:18px;
  font-weight:bold;
  cursor:pointer;
}
.play{background:#28d17c}
.cashout{background:#ffb020}
button:disabled{
  opacity:.5;
  cursor:not-allowed;
}
.balance{
  margin-top:20px;
  font-size:20px;
}
.history{
  margin-top:20px;
  background:#171e2d;
  border-radius:15px;
  padding:15px;
}
.history span{
  display:inline-block;
  margin:4px;
  padding:6px 10px;
  background:#273249;
  border-radius:8px;
}
</style>
</head>

<body>

<div class="container">

<h1>✈️ Crash Demo</h1>
<div class="demo">DEMO MODE — No Real Money</div>

<div class="game">
  <div class="multiplier" id="multiplier">1.00x</div>
  <div class="plane" id="plane">✈️</div>
</div>

<div class="balance">
  Demo Cash: <b id="balance">1000</b>
</div>

<button class="play" id="playBtn" onclick="startGame()">▶ PLAY</button>
<button class="cashout" id="cashBtn" onclick="cashOut()" disabled>
  💰 CASH OUT
</button>

<div class="history">
  <b>Recent Rounds</b>
  <div id="history"></div>
</div>

</div>

<script>
let balance = 1000;
let multiplier = 1;
let running = false;
let cashed = false;
let timer;

const multiplierEl = document.getElementById("multiplier");
const plane = document.getElementById("plane");
const balanceEl = document.getElementById("balance");
const playBtn = document.getElementById("playBtn");
const cashBtn = document.getElementById("cashBtn");
const historyEl = document.getElementById("history");

function startGame(){

  if(running) return;

  running = true;
  cashed = false;
  multiplier = 1;

  playBtn.disabled = true;
  cashBtn.disabled = false;

  multiplierEl.textContent = "1.00x";
  multiplierEl.style.color = "white";

  plane.style.left = "25px";
  plane.style.bottom = "25px";

  // Demo crash point
  let crashPoint = 1.2 + Math.random() * 8;

  timer = setInterval(() => {

    multiplier += 0.01 + multiplier * 0.003;

    multiplierEl.textContent = multiplier.toFixed(2) + "x";

    let x = Math.min(420, 25 + (multiplier-1)*45);
    let y = Math.min(230, 25 + (multiplier-1)*20);

    plane.style.left = x + "px";
    plane.style.bottom = y + "px";

    if(multiplier >= crashPoint){
      crash();
    }

  },100);
}

function cashOut(){

  if(!running || cashed) return;

  cashed = true;

  let reward = Math.floor(50 * multiplier);
  balance += reward;

  balanceEl.textContent = balance;

  multiplierEl.textContent =
    "Cashed at " + multiplier.toFixed(2) + "x";

  multiplierEl.style.color = "#28d17c";

  cashBtn.disabled = true;
}

function crash(){

  clearInterval(timer);
  running = false;

  if(!cashed){
    multiplierEl.textContent =
      "CRASH! " + multiplier.toFixed(2) + "x";
    multiplierEl.style.color = "#ff4d5e";
  }

  addHistory(multiplier);

  playBtn.disabled = false;
  cashBtn.disabled = true;
}

function addHistory(value){

  let item = document.createElement("span");
  item.textContent = value.toFixed(2) + "x";

  historyEl.prepend(item);

  if(historyEl.children.length > 8){
    historyEl.removeChild(historyEl.lastChild);
  }
}
</script>

</body>
</html>
